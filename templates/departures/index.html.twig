{% extends 'vue-base.html.twig' %}

{% block title %}Spielerabgänge - PBSJ Community{% endblock %}

{% block meta %}
    <meta name="description" content="Statistiken zu Spielerabgängen in World of Tanks - PBSJ Community Analysen">
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('vue-departures') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('vue-departures') }}
{% endblock %}

{% block content %}
    <main>
        <noscript>
            <div class="noscript-warning">
                <strong>
                    JavaScript ist erforderlich. Bitte aktivieren Sie JavaScript, um fortzufahren.
                </strong>
            </div>
        </noscript>
        <div id="departures" data-players="{{ players }}"></div>
    </main>
{% endblock %}
