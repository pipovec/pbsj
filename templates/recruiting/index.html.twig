{% extends 'vue-base.html.twig' %}

{% block title %}Rekrutierung - PBSJ Community{% endblock %}

{% block meta %}
    <meta name="description" content="Übersicht über Clan-Rekrutierungen in World of Tanks - PBSJ Community Statistiken">
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('recruiting') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('vue-recruiting') }}
{% endblock %}

{% block content %}
    <main>
        <noscript>
            <div class="noscript-warning">
                <strong>
                    JavaScript ist erforderlich. Bitte aktivieren Sie JavaScript, um fortzufahren.
                </strong>
            </div>
        </noscript>
        <div id="recruiting"></div>
    </main>
{% endblock %}
