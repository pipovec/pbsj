{% extends 'base.html.twig' %}

{% block title %}PBSJ | STAT - World of Tanks Statistiken{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('home') }}
{% endblock %}

{% block body %}
<div class="homepage-wrapper">
    <div class="homepage-container">
        <header class="homepage-header">
            <h1 class="homepage-title">PBSJ Stat</h1>
            <p class="homepage-subtitle">Statistiken und Analysen für World of Tanks</p>
        </header>

        <nav class="homepage-nav" aria-label="Hauptnavigation">
            <a href="{{ path('app_departures') }}" class="homepage-card">
                <div class="homepage-card__icon">👋</div>
                <h2 class="homepage-card__title">Spielerabgänge</h2>
                <p class="homepage-card__description">
                    Statistiken zu Spielern, die Clans verlassen haben
                </p>
            </a>

            <a href="{{ path('app_recruiting') }}" class="homepage-card">
                <div class="homepage-card__icon">📊</div>
                <h2 class="homepage-card__title">Rekrutierung</h2>
                <p class="homepage-card__description">
                    Übersicht über Clan-Rekrutierungen und neue Spieler
                </p>
            </a>
            <a href="{{ path('app_chat') }}" class="homepage-card">
                <div class="homepage-card__icon">💬</div>
                <h2 class="homepage-card__title">Pinnwand</h2>
                <p class="homepage-card__description">
                    Gemeinschafts-Pinnwand für PBSJ Spieler
                </p>
            </a>
        </nav>

        <footer class="homepage-footer">
            <p class="homepage-footer__text">
                World of Tanks Community Statistiken
            </p>
        </footer>
    </div>
</div>
{% endblock %}
